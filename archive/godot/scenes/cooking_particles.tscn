[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

func play_effect(effect_name: String):
	var node = get_node_or_null(effect_name)
	if node and node is CPUParticles2D:
		node.emitting = true
		
	# Automatically clean up Node2D after particles finish emitting
	var max_lifetime = 2.0
	var timer = get_tree().create_timer(max_lifetime)
	timer.timeout.connect(queue_free)
"

