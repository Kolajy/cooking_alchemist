# Google Antigravity SDK Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: App Data Directory Override (must be absolute path)
# AGY_APP_DATA_DIR=/Users/yourusername/pg/cooking/.antigravity

# Web client — Google Analytics 4 (GA4) measurement ID (optional)
# Create a GA4 property at https://analytics.google.com/ and copy the ID (G-XXXXXXXXXX).
# Leave blank to disable analytics in local dev and builds.
VITE_GA_MEASUREMENT_ID=
